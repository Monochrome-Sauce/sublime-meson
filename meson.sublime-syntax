%YAML 1.2
---
# https://mesonbuild.com/Syntax.html#grammar
name: Meson
scope: source.meson
version: 2

file_extensions:
  - meson.build
  - meson.options
  - meson_options.txt

variables:
  ADDITIVE_OPERATOR: (\+|\-)
  ASSIGNMENT_OPERATOR: (=|\+=)
  EQUALITY_OPERATOR: (==|!=)
  IDENTIFIER: '[a-zA-Z_][a-zA-Z_0-9]*'
  JUMP_STATEMENT: (break|continue)\n
  KEYWORDS: '(and|break|continue|elif|else|endforeach|endif|false|foreach|if|in|not|or)'
  MULTIPLICATIVE_OPERATOR: \*|\/|\%
  RELATIONAL_OPERATOR: (>|<|>=|<=|in|(not\bin))
  
  BUILTIN_FUNCTIONS: |-
    (?x:
      add_global_arguments
    | add_global_link_arguments
    | add_languages
    | add_project_arguments
    | add_project_dependencies
    | add_project_link_arguments
    | add_test_setup
    | alias_target
    | assert
    | benchmark
    | both_libraries
    | build_target
    | configuration_data
    | configure_file
    | custom_target
    | debug
    | declare_dependency
    | default
    | dependency
    | disabler
    | environment
    | error
    | executable
    | files
    | find_program
    | generator
    | get_option
    | get_variable
    | import
    | include_directories
    | install_data
    | install_emptydir
    | install_headers
    | install_man
    | install_subdir
    | install_symlink
    | is_disabler
    | is_variable
    | jar
    | join_paths
    | library
    | message
    | project
    | range
    | run_command
    | run_target
    | set_variable
    | shared_library
    | shared_module
    | static_library
    | structured_sources
    | subdir
    | subdir_done
    | subproject
    | summary
    | test
    | unset_variable
    | vcs_tag
    | warning
    )
  
  ELEMENTARY_TYPES: |-
    (?x: any | array | bool | dict | int | str | void)
  
  BUILTIN_OBJECTS: |-
    (?x: build_machine | host_machine | meson | target_machine)
  
  METHODS_MACHINE: |-
    (?x: cpu | cpu_family | endian | kernel | subsystem | system)


####################################[ MAIN ]####################################

contexts:
  main:
    - meta_include_prototype: false
    - match: ''
      push: statements

  statements:
    - include: try_expression

  try_expression:
    - include: try_literal


##################################[ LITERALS ]##################################

  try_literal:
    - include: try_binary-literal
    - include: try_boolean-literal
    - include: try_hex-literal
    - include: try_octal-literal
    - include: try_decimal-literal
    
    # - include: try_array-literal
    # - include: try_dictionary-literal
    - include: try_string-literal

  try_binary-literal:
    - match: \b0b[01]+
      scope: meta.number.integer.binary.meson constant.numeric.value.meson
    - match: \b0b[^01]*
      scope: meta.number.integer.binary.meson constant.numeric.value.meson invalid.illegal.meson
  try_boolean-literal:
    - match: \bfalse\b
      scope: constant.language.boolean.false.meson
    - match: \btrue\b
      scope: constant.language.boolean.true.meson
  try_hex-literal:
    - match: \b0x[a-fA-F0-9]+
      scope: meta.number.integer.hexadecimal.meson constant.numeric.value.meson
    - match: \b0x[^a-fA-F0-9]*
      scope: meta.number.integer.hexadecimal.meson constant.numeric.value.meson invalid.illegal.meson
  try_octal-literal:
    - match: \b0o[0-7]+
      scope: meta.number.integer.octal.meson constant.numeric.value.meson
    - match: \b0o[^0-7]*
      scope: meta.number.integer.octal.meson constant.numeric.value.meson invalid.illegal.meson
  try_decimal-literal:
    - match: \b(0([0-9]*)|[1-9][0-9]*)
      captures:
        1: meta.number.integer.decimal.meson constant.numeric.value.meson
        2: meta.number.integer.decimal.meson constant.numeric.value.meson invalid.illegal.meson

  try_string-literal:               # ("'" STRING_SIMPLE_VALUE "'") | ("'''" STRING_MULTILINE_VALUE "'''")
    - match: "'''"
      scope: string.quoted.triple.meson
      push: inside_string-multiline-value
    - match: "'"
      scope: string.quoted.single.meson
      push: inside_string-simple-value

  inside_string-multiline-value:      # '\.*?(\'\'\')'
    - meta_scope: string.quoted.triple.meson
    - match: \\.
      scope: constant.character.escape.meson
    - match: "'''"
      pop: true

  inside_string-simple-value:         # '\.*?(?<!\\)(\\\\)*?\' ?'
    - meta_scope: string.quoted.single.meson
    - match: \\.
      scope: constant.character.escape.meson
    - match: "'"
      pop: true


####################################[ POPS ]####################################

  else-pop:
    - match: (?=\S)
      pop: 1

  eol-pop:
    - match: $
      pop: 1

  immediately-pop:
    - match: ''
      pop: 1

%YAML 1.2
---
# https://mesonbuild.com/Syntax.html#grammar
name: Meson
scope: source.meson
version: 2

file_extensions:
  - meson.build
  - meson.options
  - meson_options.txt

variables:
  ADDITIVE_OPERATOR: (\+|\-)
  ASSIGNMENT_OPERATOR: (=|\+=)
  EQUALITY_OPERATOR: (==|!=)
  IDENTIFIER: '[a-zA-Z_][a-zA-Z_0-9]*'
  JUMP_STATEMENT: (break|continue)\n
  KEYWORDS: '(and|break|continue|elif|else|endforeach|endif|false|foreach|if|in|not|or)'
  MULTIPLICATIVE_OPERATOR: \*|\/|\%
  RELATIONAL_OPERATOR: (>|<|>=|<=|in|(not\bin))
  
  BUILTIN_FUNCTIONS: |-
    (?x:
      add_global_arguments
    | add_global_link_arguments
    | add_languages
    | add_project_arguments
    | add_project_dependencies
    | add_project_link_arguments
    | add_test_setup
    | alias_target
    | assert
    | benchmark
    | both_libraries
    | build_target
    | configuration_data
    | configure_file
    | custom_target
    | debug
    | declare_dependency
    | default
    | dependency
    | disabler
    | environment
    | error
    | executable
    | files
    | find_program
    | generator
    | get_option
    | get_variable
    | import
    | include_directories
    | install_data
    | install_emptydir
    | install_headers
    | install_man
    | install_subdir
    | install_symlink
    | is_disabler
    | is_variable
    | jar
    | join_paths
    | library
    | message
    | project
    | range
    | run_command
    | run_target
    | set_variable
    | shared_library
    | shared_module
    | static_library
    | structured_sources
    | subdir
    | subdir_done
    | subproject
    | summary
    | test
    | unset_variable
    | vcs_tag
    | warning
    )
  
  ELEMENTARY_TYPES: |-
    (?x: any | array | bool | dict | int | str | void)
  
  BUILTIN_OBJECTS: |-
    (?x: build_machine | host_machine | meson | target_machine)
  
  METHODS_MACHINE: |-
    (?x: cpu | cpu_family | endian | kernel | subsystem | system)


####################################[ MAIN ]####################################

contexts:
  main:
    - meta_include_prototype: false
    - match: ''
      push: statements

  prototype:
    - match: ((\#).*)$ # handle comments everywhere by default
      captures:
        1: comment.line.meson
        2: punctuation.definition.comment.meson

  statements:
    - include: try_statement-keyword
    - include: try_expression

  try_statement-keyword:
    - match: \bbreak\b
      scope: keyword.control.flow.break.meson
    - match: \bcontinue\b
      scope: keyword.control.flow.continue.meson
    - match: \belif\b
      scope: keyword.control.conditional.elseif.meson
    - match: \belse\b
      scope: keyword.control.conditional.else.meson
    - match: \bendforeach\b
      scope: keyword.control.loop.end.meson
    - match: \bendif\b
      scope: keyword.control.conditional.end.meson
    - match: \bforeach\b
      scope: keyword.control.loop.for.meson
    - match: \bif\b
      scope: keyword.control.conditional.if.meson

  try_operator:
    - match: \b(and|in|not|or)\b
      scope: keyword.operator.logical.meson
    - match: \+?=
      scope: keyword.operator.assignment.meson
    - match: ([=!><]=)|[><]
      scope: keyword.operator.comparison.meson
    - match: \+|\-|\*|\/|\%
      scope: keyword.operator.arithmetic.meson

  try_variable:
    - match: \b{{BUILTIN_OBJECTS}}\b
      scope: variable.language.meson
    - match: \b(({{BUILTIN_FUNCTIONS}})|({{IDENTIFIER}}))\s*(\()
      captures:
        2: support.function.builtin.meson
        3: variable.function.meson
        4: punctuation.section.parens.begin.meson
      push: pops1_inside-function-call
    - match: \b(({{BUILTIN_FUNCTIONS}})|({{IDENTIFIER}}))\b
      captures:
        2: support.function.builtin.meson
        3: variable.other.readwrite.meson
      push: pops1_after-expression

  try_expression:
    - match: \.
      scope: punctuation.accessor.dot.meson invalid.illegal.meson
    - include: try_operator
    - include: try_literal
    - include: try_variable

  pops1_inside-function-call:
    - meta_content_scope: meta.sequence.meson meta.function-call.arguments.meson
    - match: \)
      scope: punctuation.section.parens.end.meson
      set: pops1_after-expression
    - match: '\:'
      scope: invalid.illegal.meson
    - match: \b({{IDENTIFIER}})\s*(\:)\s*([\,\:]*)
      captures:
        1: variable.parameter.meson
        2: punctuation.separator.key-value keyword.operator.assignment.meson
        3: invalid.illegal.meson
    - include: try_expression
    - match: \,
      scope: punctuation.separator.sequence.meson

  pops1_after-expression:
    - match: (?!\.)
      pop: 1
    - match: \.
      scope: punctuation.accessor.dot.meson
    - include: try_expression
    - include: immediately-pop

##################################[ LITERALS ]##################################

  try_literal:
    - include: try_binary-literal
    - include: try_boolean-literal
    - include: try_hex-literal
    - include: try_octal-literal
    - include: try_decimal-literal
    
    - include: try_array-literal
    - include: try_string-literal

  try_binary-literal:
    - match: \b0b[01]+
      scope: meta.number.integer.binary.meson constant.numeric.value.meson
      push: pops1_after-expression
    - match: \b0b[^01\s]*
      scope: meta.number.integer.binary.meson constant.numeric.value.meson invalid.illegal.meson
  try_boolean-literal:
    - match: \bfalse\b
      scope: constant.language.boolean.false.meson
      push: pops1_after-expression
    - match: \btrue\b
      scope: constant.language.boolean.true.meson
  try_hex-literal:
    - match: \b0x[a-fA-F0-9]+
      scope: meta.number.integer.hexadecimal.meson constant.numeric.value.meson
      push: pops1_after-expression
    - match: \b0x[^a-fA-F0-9\s]*
      scope: meta.number.integer.hexadecimal.meson constant.numeric.value.meson invalid.illegal.meson
  try_octal-literal:
    - match: \b0o[0-7]+
      scope: meta.number.integer.octal.meson constant.numeric.value.meson
      push: pops1_after-expression
    - match: \b0o[^0-7\s]*
      scope: meta.number.integer.octal.meson constant.numeric.value.meson invalid.illegal.meson
  try_decimal-literal:
    - match: \b(0([0-9]*)|[1-9][0-9]*)
      captures:
        1: meta.number.integer.decimal.meson constant.numeric.value.meson
        2: invalid.illegal.meson
      push: pops1_after-expression

  try_array-literal:
    - match: \]
      scope: punctuation.section.brackets.end.meson invalid.illegal.meson
    - match: \[
      scope: punctuation.section.brackets.begin.meson
      push: pops1_inside-array-literal
  pops1_inside-array-literal:
    - meta_scope: meta.brackets.meson
    - meta_content_scope: meta.sequence.meson
    - match: \]
      scope: punctuation.section.brackets.end.meson
      set: pops1_after-expression
    - include: try_expression
    - match: \,
      scope: punctuation.separator.sequence.meson

  try_string-literal:               # ("'" STRING_SIMPLE_VALUE "'") | ("'''" STRING_MULTILINE_VALUE "'''")
    - match: "'''"
      scope: punctuation.definition.string.begin.meson
      push: pops1_inside-string-multiline-value
    - match: "'"
      scope: punctuation.definition.string.begin.meson
      push: pops1_inside-string-simple-value

  try_string-literal-character-escape:
    - match: \\\\|\\'|\\a|\\b|\\f|\\n|\\r|\\t|\\v
      scope: constant.character.escape.meson
    - match: \\[0-7]{3}
      scope: constant.character.escape.octal.meson
    - match: \\x[0-9a-fA-F]{2}
      scope: constant.character.escape.hex.meson
    - match: \\u[0-9a-fA-F]{4}
      scope: constant.character.escape.unicode.16bit.meson
    - match: \\U[0-9a-fA-F]{8}
      scope: constant.character.escape.unicode.32bit.meson
    - match: \\N\{{{IDENTIFIER}}\}
      scope: constant.character.escape.unicode.name.meson
    - match: \\.
      scope: constant.character.escape.meson invalid.illegal.meson

  pops1_inside-string-multiline-value:      # '\.*?(\'\'\')'
    - meta_include_prototype: false
    - meta_scope: meta.string.meson string.quoted.triple.meson
    - include: try_string-literal-character-escape
    - match: "'''"
      scope: punctuation.definition.string.end.meson
      set: pops1_after-expression

  pops1_inside-string-simple-value:         # '\.*?(?<!\\)(\\\\)*?\' ?'
    - meta_include_prototype: false
    - meta_scope: meta.string.meson string.quoted.single.meson
    - match: \n
      scope: invalid.illegal.meson
      pop: 1
    - include: try_string-literal-character-escape
    - match: "'"
      scope: punctuation.definition.string.end.meson
      set: pops1_after-expression


###################################[ HELPER ]###################################

  else-pop1:
    - match: (?=\S)
      pop: 1

  eol-pop1:
    - match: $
      pop: 1

  immediately-pop1:
    - match: ''
      pop: 1
